# Copie ce fichier en ".env" (meme dossier) et remplis tes valeurs.

# ElevenLabs (voix) - obligatoire pour que Jarvis parle
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optionnel : sites ouverts dans Chrome au double clap (autant que tu veux, separes par des virgules)
# DASHBOARD_URLS=https://n8n.digital-mib.com/,https://mail.google.com/mail/u/0/#inbox,https://monsite.com

# Optionnel : jouer un fichier WAV local en fond (pas d'appli qui s'ouvre) au lieu du lien Spotify
# SONG_FILE=wake.wav

# Optionnel : forcer un micro precis (index ou bout de son nom)
# JARVIS_INPUT_DEVICE=

# Optionnel : mode debug (affiche niveau/seuil a chaque pic detecte)
# JARVIS_DEBUG=1
